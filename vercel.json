{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://cinerate-backend-i19p.onrender.com/api/:match*"
    },
    {
      "source": "/health",
      "destination": "https://cinerate-backend-i19p.onrender.com/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
